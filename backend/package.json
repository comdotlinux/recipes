{
  "name": "recipe-box-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "test": "vitest run --exclude 'test/spikes/**'",
    "test:spikes": "vitest run test/spikes",
    "build:check": "wrangler deploy --dry-run --outdir dist --env production"
  },
  "dependencies": {
    "hono": "4.13.21"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.2",
    "@vitest/coverage-istanbul": "5.1.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.168.0"
  }
}
