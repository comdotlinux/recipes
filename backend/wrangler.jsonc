// Deploy targets are the environments (Worker names recipes-<env>). The top level only supplies
// inheritable defaults. Its dataset and rate-limit namespace ids (9xxx) are its own, so a bare
// `wrangler deploy` cannot write to production resources. Bindings are not inheritable, so each environment repeats them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipes",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/v1/*"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDO"] }],
  "durable_objects": { "bindings": [{ "name": "USER_DO", "class_name": "UserDO" }] },
  "ai": { "binding": "AI" },
  // namespace_id values are account-scoped integers chosen by us, not secrets.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "recipes_metrics_toplevel" }],
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "9001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_USER", "namespace_id": "9002", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_GLOBAL", "namespace_id": "9003", "simple": { "limit": 600, "period": 60 } }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    // Local dev and tests only: test entry with the test IdP. No AI binding,
    // because Workers AI always calls the account; a local AI stub is added when M2 needs one.
    "local": {
      "main": "src/index.local.ts",
      "durable_objects": { "bindings": [{ "name": "USER_DO", "class_name": "UserDO" }] },
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "recipes_metrics_local" }],
      "ratelimits": [
        { "name": "RL_IP", "namespace_id": "8001", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_USER", "namespace_id": "8002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_GLOBAL", "namespace_id": "8003", "simple": { "limit": 600, "period": 60 } }
      ]
    },
    "staging": {
      "workers_dev": true,
      "preview_urls": true,
      "durable_objects": { "bindings": [{ "name": "USER_DO", "class_name": "UserDO" }] },
      "ai": { "binding": "AI" },
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "recipes_metrics_staging" }],
      "ratelimits": [
        { "name": "RL_IP", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_USER", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_GLOBAL", "namespace_id": "2003", "simple": { "limit": 600, "period": 60 } }
      ]
    },
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "durable_objects": { "bindings": [{ "name": "USER_DO", "class_name": "UserDO" }] },
      "ai": { "binding": "AI" },
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "recipes_metrics" }],
      "ratelimits": [
        { "name": "RL_IP", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_USER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_GLOBAL", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } }
      ]
    }
  }
}
