// Deploy targets are the environments (Worker names recipes-<env>). The top level only supplies
// inheritable defaults. Its dataset and rate-limit namespace ids (9xxx) are its own, so a bare
// `wrangler deploy` cannot write to production resources. APPLE_AUDIENCES / GOOGLE_AUDIENCES are public client ids
// (comma-separated); empty accepts no token until the owner fills them in. DO_JURISDICTION is "eu" wherever the Worker
// is deployed; local workerd does not implement jurisdictions, so env.local leaves it empty. TURNSTILE_SITE_KEY is public;
// env.local uses Cloudflare's public always-pass test site key and test secret
// (https://developers.cloudflare.com/turnstile/troubleshooting/testing/); only env.local may contain them. Bindings are not inheritable, so each environment repeats them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipes",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  // fetch() to a hostname of our own zone goes through Cloudflare's front door, not straight to the origin
  // (https://developers.cloudflare.com/workers/configuration/compatibility-flags/, "Global fetch() strictly public", checked 2026-11-24).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/v1/*", "/turnstile.html", "/s", "/.well-known/*"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDO"] }],
  "durable_objects": { "bindings": [{ "name": "USER_DO", "class_name": "UserDO" }] },
  "secrets": { "required": ["USER_ID_PEPPER", "SERVER_KEY", "TURNSTILE_SECRET", "REVENUECAT_API_KEY", "REVENUECAT_WEBHOOK_SECRET"] },
  "vars": { "APPLE_AUDIENCES": "", "GOOGLE_AUDIENCES": "", "DO_JURISDICTION": "eu", "TURNSTILE_SITE_KEY": "",
    "REVENUECAT_API_BASE": "https://api.revenuecat.com/v1", "REVENUECAT_ENTITLEMENT": "recipes_pro" },
  "ai": { "binding": "AI" },
  // Browser Run Quick Actions for GET /recipes/:id/pdf (src/pdf.ts); env.local has none, so the route answers 503 there.
  "browser": { "binding": "BROWSER" },
  // namespace_id values are account-scoped integers chosen by us, not secrets.
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "recipes_metrics_toplevel" }],
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "9001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_USER", "namespace_id": "9002", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_GLOBAL", "namespace_id": "9003", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_WEBHOOK", "namespace_id": "9004", "simple": { "limit": 120, "period": 60 } }
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs (docs/versions/backend.md, "Logs"): no invocation logs (one line per request with method and URL);
  // only the Worker's own console lines, which name events and codes only. Query strings redacted if logs ever name a URL.
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 }, "traces": { "enabled": false } },
  "env": {
    // Local dev and tests only: test entry with the test IdP. No AI binding,
    // because Workers AI always calls the account; a local AI stub is added when M2 needs one.
    "local": {
      "main": "src/index.local.ts",
      // Explicit, not inherited: this entry must never get a public URL (it also refuses non-local hosts).
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "durable_objects": { "bindings": [{ "name": "USER_DO", "class_name": "UserDO" }] },
      "secrets": { "required": [] },
      "vars": {
        "APPLE_AUDIENCES": "local.test.apple",
        "GOOGLE_AUDIENCES": "local.test.google",
        "DO_JURISDICTION": "",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA",
        // Development values, not secrets: env.local is never deployed. Tests check they stay out of the other environments.
        "USER_ID_PEPPER": "dev-only-user-id-pepper",
        "SERVER_KEY": "dev-only-server-key",
        // No RevenueCat key locally: the local entry then uses src/testing/local-billing.ts (README "Try the subscription locally").
        "REVENUECAT_API_BASE": "https://api.revenuecat.com/v1",
        "REVENUECAT_ENTITLEMENT": "recipes_pro"
      },
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "recipes_metrics_local" }],
      "ratelimits": [
        { "name": "RL_IP", "namespace_id": "8001", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_USER", "namespace_id": "8002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_GLOBAL", "namespace_id": "8003", "simple": { "limit": 600, "period": 60 } },
        { "name": "RL_WEBHOOK", "namespace_id": "8004", "simple": { "limit": 120, "period": 60 } }
      ]
    },
    "staging": {
      "workers_dev": true,
      "preview_urls": true,
      "durable_objects": { "bindings": [{ "name": "USER_DO", "class_name": "UserDO" }] },
      "secrets": { "required": ["USER_ID_PEPPER", "SERVER_KEY", "TURNSTILE_SECRET", "REVENUECAT_API_KEY", "REVENUECAT_WEBHOOK_SECRET"] },
      "vars": { "APPLE_AUDIENCES": "", "GOOGLE_AUDIENCES": "", "DO_JURISDICTION": "eu", "TURNSTILE_SITE_KEY": "",
        "REVENUECAT_API_BASE": "https://api.revenuecat.com/v1", "REVENUECAT_ENTITLEMENT": "recipes_pro" },
      "ai": { "binding": "AI" },
      "browser": { "binding": "BROWSER" },
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "recipes_metrics_staging" }],
      "ratelimits": [
        { "name": "RL_IP", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_USER", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_GLOBAL", "namespace_id": "2003", "simple": { "limit": 600, "period": 60 } },
        { "name": "RL_WEBHOOK", "namespace_id": "2004", "simple": { "limit": 120, "period": 60 } }
      ]
    },
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "durable_objects": { "bindings": [{ "name": "USER_DO", "class_name": "UserDO" }] },
      "secrets": { "required": ["USER_ID_PEPPER", "SERVER_KEY", "TURNSTILE_SECRET", "REVENUECAT_API_KEY", "REVENUECAT_WEBHOOK_SECRET"] },
      "vars": { "APPLE_AUDIENCES": "", "GOOGLE_AUDIENCES": "", "DO_JURISDICTION": "eu", "TURNSTILE_SITE_KEY": "",
        "REVENUECAT_API_BASE": "https://api.revenuecat.com/v1", "REVENUECAT_ENTITLEMENT": "recipes_pro" },
      "ai": { "binding": "AI" },
      "browser": { "binding": "BROWSER" },
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "recipes_metrics" }],
      "ratelimits": [
        { "name": "RL_IP", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_USER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_GLOBAL", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } },
        { "name": "RL_WEBHOOK", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
      ]
    }
  }
}
